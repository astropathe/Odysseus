{
  "manifest_version": 2,
  "name": "Odysseus",
  "version": "1.0",
  "description": "IA locale d'obfuscation sémantique",
  "permissions": [
    "tabs",
    "storage",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_action": {
    "default_title": "Odysseus Monitor",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    "lib/ort-wasm.wasm",
    "lib/ort-wasm-simd.wasm",
    "lib/ort-wasm-threaded.wasm"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "odysseus-io@astropathe.addons",
      "strict_min_version": "109.0"
    }
  }
}